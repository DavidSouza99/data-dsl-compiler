cabal-version:      3.0
name:                data-dsl-compiler
version:             0.1.0.0
synopsis:            DSL declarativa para pipelines de dados, compilada para Python/pandas
license:             BSD-3-Clause
build-type:          Simple

common common-opts
  build-depends:
      base >= 4.18.2.1
    , containers
    , array
  default-language: Haskell2010
  ghc-options: -Wall

  build-tool-depends: alex:alex

executable data-dsl-compiler
  import:           common-opts
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      base >= 4.18.2.1
      ,data-dsl-compiler

library 
  import:           common-opts
  exposed-modules:
      DataDSL.Frontend.Lexer.Token
      DataDSL.Frontend.Lexer.AdHocLexer
      DataDSL.Frontend.Lexer.DataDSLLexer
  hs-source-dirs:   src
